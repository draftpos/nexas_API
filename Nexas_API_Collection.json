{
    "info": {
        "name": "Nexas API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Login",
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"usr\": \"Administrator\",\n    \"pwd\": \"admin\",\n    \"timezone\": \"Africa/Harare\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/api/method/nexas_api.api.login",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "method",
                        "nexas_api.api.login"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "let response = pm.response.json();",
                            "if (response.token_string) {",
                            "    pm.collectionVariables.set('token', response.token_string);",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        },
        {
            "name": "2. Get Products",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "token {{token}}",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"page\": 1,\n    \"limit\": 1000\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/api/method/nexas_api.api.get_products",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "method",
                        "nexas_api.api.get_products"
                    ]
                }
            }
        },
        {
            "name": "3. Create Sales Invoice (Legacy Native API)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "token {{token}}",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"docstatus\": 1,\n    \"doctype\": \"Sales Invoice\",\n    \"naming_series\": \"ACC-SINV-.YYYY.-\",\n    \"company\": \"Main - S\",\n    \"customer\": \"Cash Customer\",\n    \"posting_date\": \"2026-10-02\",\n    \"posting_time\": \"12:00:00\",\n    \"set_posting_time\": 1,\n    \"update_stock\": 1,\n    \"set_warehouse\": \"Stores - S\",\n    \"currency\": \"USD\",\n    \"conversion_rate\": 1.0,\n    \"selling_price_list\": \"Standard Selling\",\n    \"price_list_currency\": \"USD\",\n    \"plc_conversion_rate\": 1.0,\n    \"po_no\": \"POS-1003\",\n    \"items\": [\n        {\n            \"item_code\": \"PROD-001\",\n            \"item_name\": \"Product 1\",\n            \"description\": \"Product 1\",\n            \"qty\": 2.0,\n            \"rate\": 150.0,\n            \"price_list_rate\": 150.0,\n            \"allow_zero_valuation_rate\": 1,\n            \"valuation_rate\": 0,\n            \"uom\": \"Nos\",\n            \"discount_percentage\": 0.0,\n            \"cost_center\": \"Main - S\"\n        }\n    ],\n    \"taxes\": [\n        {\n            \"charge_type\": \"Actual\",\n            \"account_head\": \"VAT - S\",\n            \"description\": \"VAT\",\n            \"cost_center\": \"Main - S\",\n            \"rate\": 0,\n            \"tax_amount\": 0,\n            \"included_in_print_rate\": 1\n        }\n    ],\n    \"payments\": [\n        {\n            \"mode_of_payment\": \"Cash\",\n            \"amount\": 300.0,\n            \"account\": \"Cash - S\"\n        }\n    ]\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/api/resource/Sales Invoice",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "resource",
                        "Sales Invoice"
                    ]
                }
            }
        },
        {
            "name": "4. Create Payment Entry (Legacy Native API)",
