{
	"info": {
		"name": "Nexas API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Login",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "formdata",
					"formdata": [
						{ "key": "usr", "value": "Administrator", "type": "text" },
						{ "key": "pwd", "value": "admin", "type": "text" },
						{ "key": "timezone", "value": "Africa/Harare", "type": "text" }
					]
				},
				"url": {
					"raw": "{{base_url}}/api/method/nexas_api.api.login",
					"host": ["{{base_url}}"],
					"path": ["api", "method", "nexas_api.api.login"]
				}
			}
		},
		{
			"name": "2. Stock Transfer (Products)",
			"request": {
				"method": "POST",
				"header": [{"key": "Authorization", "value": "token {{token}}", "type": "text"}],
				"body": {
					"mode": "formdata",
					"formdata": [
						{ "key": "page", "value": "1", "type": "text" },
						{ "key": "limit", "value": "1000", "type": "text" }
					]
				},
				"url": {
					"raw": "{{base_url}}/api/method/nexas_api.api.get_products",
					"host": ["{{base_url}}"],
					"path": ["api", "method", "nexas_api.api.get_products"]
				}
			}
		},
		{
			"name": "3. Create Sales Invoice",
			"request": {
				"method": "POST",
				"header": [{"key": "Authorization", "value": "token {{token}}", "type": "text"}],
				"body": {
					"mode": "formdata",
					"formdata": [
						{ "key": "customer", "value": "Cash Customer", "type": "text" },
						{ "key": "company", "value": "Showline", "type": "text" },
						{ "key": "reference_number", "value": "POS-INV-0001", "type": "text", "description": "Mandatory unique reference" },
						{ "key": "currency", "value": "USD", "type": "text", "description": "Optional currency override" },
						{ "key": "posting_date", "value": "2026-10-01", "type": "text", "description": "Optional" },
						{ "key": "posting_time", "value": "15:30:00", "type": "text", "description": "Optional HH:MM:SS" },
						{ "key": "items", "value": "[{\"item_code\": \"ITEM-001\", \"qty\": 1, \"rate\": 100}]", "type": "text" }
					]
				},
				"url": {
					"raw": "{{base_url}}/api/method/nexas_api.api.create_invoice",
					"host": ["{{base_url}}"],
					"path": ["api", "method", "nexas_api.api.create_invoice"]
				}
			}
		},
		{
			"name": "4. Create Payment Entry",
			"request": {
				"method": "POST",
				"header": [{"key": "Authorization", "value": "token {{token}}", "type": "text"}],
				"body": {
					"mode": "formdata",
					"formdata": [
						{ "key": "party", "value": "Cash Customer", "type": "text" },
						{ "key": "amount", "value": "100", "type": "text" },
						{ "key": "mode_of_payment", "value": "Cash", "type": "text" },
						{ "key": "reference_doctype", "value": "Sales Invoice", "type": "text" },
						{ "key": "reference_name", "value": "SINV-00001", "type": "text" }
					]
				},
				"url": {
					"raw": "{{base_url}}/api/method/nexas_api.api.payment_entry",
					"host": ["{{base_url}}"],
					"path": ["api", "method", "nexas_api.api.payment_entry"]
				}
			}
		},
		{
			"name": "5. Get Default Cost Center",
			"request": {
				"method": "POST",
				"header": [{"key": "Authorization", "value": "token {{token}}", "type": "text"}],
				"body": {
					"mode": "formdata",
					"formdata": [
						{ "key": "company", "value": "Showline", "type": "text" }
					]
				},
				"url": {
					"raw": "{{base_url}}/api/method/nexas_api.api.default_cost_center",
					"host": ["{{base_url}}"],
					"path": ["api", "method", "nexas_api.api.default_cost_center"]
				}
			}
		},
		{
			"name": "6. Chart of Accounts",
			"request": {
				"method": "POST",
				"header": [{"key": "Authorization", "value": "token {{token}}", "type": "text"}],
				"url": {
					"raw": "{{base_url}}/api/method/nexas_api.api.get_account",
					"host": ["{{base_url}}"],
					"path": ["api", "method", "nexas_api.api.get_account"]
				}
			}
		},
		{
			"name": "7. Stock Reconciliation",
			"request": {
				"method": "POST",
				"header": [{"key": "Authorization", "value": "token {{token}}", "type": "text"}],
				"body": {
					"mode": "formdata",
					"formdata": [
						{ "key": "from_date", "value": "2026-09-01", "type": "text" },
						{ "key": "to_date", "value": "2026-10-31", "type": "text" }
					]
				},
				"url": {
					"raw": "{{base_url}}/api/method/nexas_api.api.get_stock_reconciliation_with_items",
					"host": ["{{base_url}}"],
					"path": ["api", "method", "nexas_api.api.get_stock_reconciliation_with_items"]
				}
			}
		},
		{
			"name": "8. Get Customers",
			"request": {
				"method": "POST",
				"header": [{"key": "Authorization", "value": "token {{token}}", "type": "text"}],
				"url": {
					"raw": "{{base_url}}/api/method/nexas_api.api.get_customers",
					"host": ["{{base_url}}"],
					"path": ["api", "method", "nexas_api.api.get_customers"]
				}
			}
		},
		{
			"name": "9. Create Customer",
			"request": {
				"method": "POST",
				"header": [{"key": "Authorization", "value": "token {{token}}", "type": "text"}],
				"body": {
					"mode": "formdata",
					"formdata": [
						{ "key": "customer_name", "value": "New POS Customer", "type": "text" },
						{ "key": "customer_group", "value": "Commercial", "type": "text" },
						{ "key": "territory", "value": "All Territories", "type": "text" }
					]
				},
				"url": {
					"raw": "{{base_url}}/api/method/nexas_api.api.create_customer",
					"host": ["{{base_url}}"],
					"path": ["api", "method", "nexas_api.api.create_customer"]
				}
			}
		},
		{
			"name": "10. Create Journal Entry",
			"request": {
				"method": "POST",
				"header": [{"key": "Authorization", "value": "token {{token}}", "type": "text"}],
				"body": {
					"mode": "formdata",
					"formdata": [
						{ "key": "company", "value": "Showline", "type": "text" },
						{ "key": "accounts", "value": "[{\"account\": \"Cash - S\", \"debit\": 100, \"cost_center\": \"Main - S\"}, {\"account\": \"Sales - S\", \"credit\": 100, \"cost_center\": \"Main - S\"}]", "type": "text" }
					]
				},
				"url": {
					"raw": "{{base_url}}/api/method/nexas_api.api.create_journal_entry",
					"host": ["{{base_url}}"],
					"path": ["api", "method", "nexas_api.api.create_journal_entry"]
				}
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000"
		},
		{
			"key": "token",
			"value": "YOUR_API_KEY:YOUR_API_SECRET"
		}
	]
}
